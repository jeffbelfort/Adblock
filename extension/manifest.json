{
  "manifest_version": 3,
  "name": "Adblock",
  "version": "2.0.0",
  "description": "Custom ad blocker. DNS + request blocking + cosmetic filtering + uBlock filter compatibility.",

  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "scripting",
    "storage",
    "tabs",
    "activeTab",
    "alarms"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["itvx-inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "exclude_matches": [
        "*://accounts.google.com/*",
        "*://ogs.google.com/*",
        "*://www.google.com/*",
        "*://mail.google.com/*",
        "*://drive.google.com/*"
      ]
    }
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block_ads",
        "enabled": true,
        "path": "rules/block_ads.json"
      },
      {
        "id": "block_youtube",
        "enabled": true,
        "path": "rules/block_youtube.json"
      },
      {
        "id": "block_streaming",
        "enabled": true,
        "path": "rules/block_streaming.json"
      }
    ]
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_page": "dashboard.html",

  "web_accessible_resources": [
    {
      "resources": ["empty.xml", "empty.js", "itvx-inject.js"],
      "matches": ["<all_urls>"]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
